NODE_ENV=production
DEPLOYMENT_ENV=production
APP_VERSION=replace-with-release-version
APP_COMMIT_SHA=replace-with-commit-sha
DATABASE_SCHEMA_VERSION=replace-with-schema-version
API_PORT=3001
API_INTERNAL_URL=http://api:3001
WEB_PUBLIC_URL=https://app.example.com
EMAIL_PROVIDER=gmail-api
EMAIL_FROM=no-reply@example.com
EMAIL_FROM_NAME=RehabMIS
GMAIL_API_CLIENT_ID=replace-me
GMAIL_API_CLIENT_SECRET=replace-me
GMAIL_API_REFRESH_TOKEN=replace-me
REDIS_URL=redis://redis:6379
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
S3_ENDPOINT=https://s3.example.com
S3_REGION=eu-central-1
S3_ACCESS_KEY=replace-with-s3-access-key
S3_SECRET_KEY=replace-with-s3-secret-key
S3_BUCKET_DOCUMENTS=replace-with-documents-bucket
S3_BUCKET_MODELS=replace-with-models-bucket
S3_FORCE_PATH_STYLE=false
NEXT_PUBLIC_S3_PUBLIC_URL=https://cdn.example.com
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=replace-with-a-random-secret-at-least-32-characters
NEON_API_KEY=replace-with-a-scoped-neon-api-key
NEON_PROJECT_ID=replace-with-neon-project-id
NEON_BRANCH_ID=replace-with-neon-branch-id
API_PUBLIC_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
METRICS_TOKEN=replace-with-metrics-token
API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
PATIENT_MEDIA_MAX_IMAGE_BYTES=50000000
PATIENT_MEDIA_MAX_VIDEO_BYTES=2000000000
PATIENT_MEDIA_UPLOAD_URL_TTL_SECONDS=300
