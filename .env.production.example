# Copy into the deployment secret manager; do not commit populated values.
NODE_ENV=production
DEPLOYMENT_ENV=production
APP_VERSION=REQUIRED_RELEASE_VERSION
APP_COMMIT_SHA=REQUIRED_FULL_COMMIT_SHA
DATABASE_SCHEMA_VERSION=20260904100000_staff_administration

API_PORT=3001
API_PUBLIC_URL=https://api.example.invalid
WEB_PUBLIC_URL=https://app.example.invalid
API_INTERNAL_URL=http://api:3001
NEXT_PUBLIC_API_URL=https://api.example.invalid
NEXT_PUBLIC_S3_PUBLIC_URL=https://objects.example.invalid
LOG_LEVEL=info
SWAGGER_ENABLED=false

DATABASE_URL=REQUIRED_SECRET
REDIS_URL=REQUIRED_SECRET
S3_ENDPOINT=https://objects.example.invalid
S3_REGION=REQUIRED_REGION
S3_ACCESS_KEY=REQUIRED_SECRET
S3_SECRET_KEY=REQUIRED_32_PLUS_CHARACTER_SECRET
S3_BUCKET_DOCUMENTS=rehabcrm-documents-production
S3_BUCKET_MODELS=rehabcrm-models-production
S3_FORCE_PATH_STYLE=false

AUTH_SECRET=REQUIRED_32_PLUS_CHARACTER_SECRET
AUTH_URL=https://app.example.invalid
AUTH_KEYCLOAK_ID=rehabcrm-web
AUTH_KEYCLOAK_SECRET=REQUIRED_32_PLUS_CHARACTER_SECRET
AUTH_KEYCLOAK_ISSUER=https://identity.example.invalid/realms/rehabcrm
OIDC_ISSUER=https://identity.example.invalid/realms/rehabcrm
OIDC_AUDIENCE=rehabcrm-api
OIDC_ADMIN_BASE_URL=https://identity.example.invalid
OIDC_ADMIN_REALM=rehabcrm
OIDC_ADMIN_CLIENT_ID=rehabcrm-provisioner
OIDC_ADMIN_CLIENT_SECRET=REQUIRED_32_PLUS_CHARACTER_SECRET
OIDC_ADMIN_ACTION_LIFESPAN_SECONDS=43200
METRICS_TOKEN=REQUIRED_32_PLUS_CHARACTER_RANDOM_TOKEN

API_RATE_LIMIT_TTL_MS=60000
API_RATE_LIMIT_MAX=120
