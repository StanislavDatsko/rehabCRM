# RehabCRM environment (never commit real secrets)

NODE_ENV=development
DEPLOYMENT_ENV=development
APP_VERSION=0.0.0-dev
APP_COMMIT_SHA=local
DATABASE_SCHEMA_VERSION=20260904100000_staff_administration

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Web
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
EMAIL_PROVIDER=console
EMAIL_FROM=RehabMIS <no-reply@example.test>
GMAIL_SMTP_USER=staff-invitations@example.test
GMAIL_SMTP_APP_PASSWORD=replace-with-a-gmail-app-password
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=rehabcrm
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rehabcrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rehabcrm:change-me-local-only@localhost:5432/rehabcrm?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rehabcrm
S3_SECRET_KEY=rehabcrmsecret
S3_BUCKET_DOCUMENTS=rehabcrm-documents
S3_BUCKET_MODELS=rehabcrm-models
PATIENT_MEDIA_MAX_IMAGE_BYTES=50000000
PATIENT_MEDIA_MAX_VIDEO_BYTES=2000000000
PATIENT_MEDIA_UPLOAD_URL_TTL_SECONDS=300
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=rehabcrm
MINIO_ROOT_PASSWORD=rehabcrmsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Neon Managed Better Auth (server-only cookie secret must be >= 32 characters)
NEON_AUTH_BASE_URL=https://your-branch.neonauth.region.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=dev-only-neon-auth-cookie-secret-change-me
# API-only Neon Management API credentials; never expose to the client bundle
NEON_API_KEY=replace-with-neon-api-key
NEON_PROJECT_ID=replace-with-neon-project-id
NEON_BRANCH_ID=replace-with-neon-branch-id
METRICS_TOKEN=dev-only-metrics-token-not-for-production
