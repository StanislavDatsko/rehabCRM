# RehabCRM environment (never commit real secrets)

NODE_ENV=development
DEPLOYMENT_ENV=development
APP_VERSION=0.0.0-dev
APP_COMMIT_SHA=local
DATABASE_SCHEMA_VERSION=20260904100000_staff_administration

# API
API_PORT=3001
API_PUBLIC_URL=http://localhost:3001
LOG_LEVEL=info
SWAGGER_ENABLED=true

# Web
WEB_PORT=3000
WEB_PUBLIC_URL=http://localhost:3000
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL
POSTGRES_USER=rehabcrm
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rehabcrm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://rehabcrm:change-me-local-only@localhost:5432/rehabcrm?schema=public

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=rehabcrm
S3_SECRET_KEY=rehabcrmsecret
S3_BUCKET_DOCUMENTS=rehabcrm-documents
S3_BUCKET_MODELS=rehabcrm-models
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=rehabcrm
MINIO_ROOT_PASSWORD=rehabcrmsecret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Keycloak / Auth.js (BFF confidential client — never NEXT_PUBLIC)
KEYCLOAK_PORT=8080
AUTH_SECRET=dev-only-auth-secret-not-for-production-use
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=rehabcrm-web
AUTH_KEYCLOAK_SECRET=rehabcrm-web-dev-secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/rehabcrm
OIDC_ISSUER=http://localhost:8080/realms/rehabcrm
OIDC_AUDIENCE=rehabcrm-api
OIDC_CLIENT_ID=rehabcrm-web
OIDC_CLIENT_SECRET=rehabcrm-web-dev-secret
OIDC_ADMIN_BASE_URL=http://localhost:8080
OIDC_ADMIN_REALM=rehabcrm
OIDC_ADMIN_CLIENT_ID=rehabcrm-provisioner
OIDC_ADMIN_CLIENT_SECRET=rehabcrm-provisioner-dev-secret
OIDC_ADMIN_ACTION_LIFESPAN_SECONDS=43200
METRICS_TOKEN=dev-only-metrics-token-not-for-production
